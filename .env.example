# Never commit populated secrets. Local API uses scripts/run-api.sh.
# Production configuration may be loaded from an existing AWS Secrets Manager
# JSON secret whose keys use Hisaab:Auth:google:ClientIds etc.
Hisaab__TableName=
Hisaab__SecretsArn=
Hisaab__Auth__google__ClientIds=
Hisaab__Auth__apple__ClientIds=
Hisaab__Auth__apple__AndroidPackage=app.hisaab.hisaab
Hisaab__Auth__apple__TeamId=
Hisaab__Auth__apple__KeyId=
Hisaab__Auth__apple__PrivateKey=
# Base64 of 32 random bytes. Required to encrypt Apple's refresh token.
Hisaab__EncryptionKey=
# Independent high-entropy contact lookup HMAC secret.
Hisaab__ContactHashKey=
Hisaab__RevenueCat__SecretKey=
Hisaab__RevenueCat__WebhookAuthorization=
Hisaab__RevenueCat__Environment=PRODUCTION
Hisaab__Firebase__ServiceAccountJson=
Hisaab__InviteBaseUrl=
