# Never commit populated secrets. Local API uses scripts/run-api.sh.
# Production configuration may be loaded from an existing AWS Secrets Manager
# JSON secret whose keys use Hisaab:Auth:google:ClientIds etc.
Hisaab__TableName=
Hisaab__SecretsArn=
# Comma-separated allowed ID-token audiences; see docs/runbooks/authentication.md.
Hisaab__Auth__google__ClientIds=
Hisaab__Auth__apple__ClientIds=
# Android Apple web flow only: match the mobile values and Apple's registration.
Hisaab__Auth__apple__ServiceId=
Hisaab__Auth__apple__RedirectUri=
Hisaab__Auth__apple__AndroidPackage=app.hisaab.hisaab
Hisaab__Auth__apple__TeamId=
Hisaab__Auth__apple__KeyId=
Hisaab__Auth__apple__PrivateKey=
# SMS login: Twilio Verify service with six-digit codes. Backend secrets only.
# Enable after service/country setup; see docs/runbooks/authentication.md.
Hisaab__Auth__Phone__Enabled=false
Hisaab__Auth__Phone__ServiceSid=
Hisaab__Auth__Phone__ApiKeySid=
Hisaab__Auth__Phone__ApiKeySecret=
Hisaab__Auth__Phone__MaxSmsPerDay=100
Hisaab__Auth__Phone__MaxSmsPerMinute=10
# Base64 of 32 random bytes. Encrypts Apple refresh tokens and phone challenges.
Hisaab__EncryptionKey=
# Independent high-entropy contact/phone-identity HMAC secret. Preserve across deploys.
Hisaab__ContactHashKey=
Hisaab__RevenueCat__SecretKey=
Hisaab__RevenueCat__WebhookAuthorization=
Hisaab__RevenueCat__Environment=PRODUCTION
Hisaab__Firebase__ServiceAccountJson=
Hisaab__InviteBaseUrl=
# Scanning stays disabled until regional provider/device validation.
Hisaab__Receipts__Enabled=false
Hisaab__Receipts__ProviderValidated=false
Hisaab__Receipts__EmergencyStop=false
Hisaab__Receipts__PauseFree=false
# CDK sets bucket/queue; encrypted local storage is development-only.
Hisaab__Receipts__BucketName=
Hisaab__Receipts__QueueUrl=
Hisaab__Receipts__VertexProject=
Hisaab__Receipts__VertexRegion=asia-south1
Hisaab__Receipts__VertexModel=gemini-3.5-flash
# Exact //iam.googleapis.com/projects/NUMBER/locations/global/workloadIdentityPools/POOL/providers/PROVIDER
Hisaab__Receipts__WorkloadIdentityAudience=
Hisaab__Receipts__ServiceAccountEmail=
# Required positive USD values. Bound every three-image attempt at reviewed
# regional input/output/thinking-token prices; each retry consumes this budget.
Hisaab__Receipts__MonthlyBudgetUsd=
Hisaab__Receipts__MaxAttemptCostUsd=
Hisaab__Receipts__MaxPendingUploadBytes=314572800
Hisaab__Receipts__MaxDownloadBytesPerHour=314572800
Hisaab__Receipts__MaxDownloadChunksPerMinute=60
